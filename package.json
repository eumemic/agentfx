{
  "name": "agentfx",
  "version": "0.1.0",
  "description": "A typed effect system whose production interpreter is a durable distributed runtime (iii). One program, two interpreters, differentially tested.",
  "keywords": [
    "effect-system",
    "typescript",
    "agents",
    "durable",
    "iii",
    "interpreter",
    "at-least-once"
  ],
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src/effect.ts",
    "src/interpret.ts",
    "src/runtime-iii.ts",
    "src/schema.ts",
    "src/remote.ts",
    "src/contracts.generated.ts",
    "src/gen.ts",
    "src/util.ts",
    "src/index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "executor": "tsx src/ex-executor.ts",
    "differential": "tsx src/ex-differential.ts",
    "durability": "tsx src/ex-durability.ts",
    "schema": "tsx src/ex-schema.ts",
    "catch": "tsx src/ex-catch.ts",
    "gen": "tsx src/gen.ts",
    "remote": "tsx src/ex-remote.ts",
    "agent": "tsx src/ex-agent.ts",
    "preempt-agent": "tsx src/ex-preempt-agent.ts",
    "preempt": "tsx src/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "iii-sdk": "0.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
